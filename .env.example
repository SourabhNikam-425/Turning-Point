# Solace Event Portal API Authentication
SOLACE_API_TOKEN=your_solace_api_token_here
SOLACE_API_BASE_URL=https://api.solace.cloud

# Enable/Disable Solace MCP Servers
ENABLE_SOLACE_EP_DESIGNER_MCP=true
ENABLE_SOLACE_MONITORING_MCP=true
ENABLE_SOLACE_CONFIG_MCP=true

# Solace PubSub+ SEMPv2 Config/Monitor API Credentials
# SOLACE_SEMPV2_BASE_URL should point to the SEMPv2 Config endpoint:
#   e.g. https://<host>:943/SEMP/v2/config
# The Monitor URL is auto-derived by replacing /config with /monitor.
# Override SOLACE_SEMPV2_MONITOR_BASE_URL to set it explicitly.
SOLACE_SEMPV2_BASE_URL=http://localhost:8080/SEMP/v2/config
SOLACE_SEMPV2_AUTH_METHOD=basic
SOLACE_SEMPV2_USERNAME=admin
SOLACE_SEMPV2_PASSWORD=admin
# SOLACE_SEMPV2_BEARER_TOKEN=
# SOLACE_SEMPV2_MONITOR_BASE_URL=http://localhost:8080/SEMP/v2/monitor  # Optional override

# Dynamic Tool Selection Optimization Layer
OLLAMA_MAX_TOOLS_PER_QUERY=30

# Ollama LLM Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.85
OLLAMA_TOP_K=40
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=2048
OLLAMA_REPEAT_PENALTY=1.1

LOG_LEVEL=INFO
