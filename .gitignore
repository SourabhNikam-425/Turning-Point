# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
wheels/

# Virtual environments
.venv/

# Environment variables (contains secrets)
.env

# Testing
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

--- a/.gitignore
+++ b/.gitignore
@@
 .idea/
 
 # OS
 .DS_Store
 Thumbs.db
+
+# ----------------------------------------------------------------------
+# Additional patterns for sensitive files that are commonly present
+# ----------------------------------------------------------------------
+
+# Environment files for other environments (dev, prod, test, etc.)
+.env.*
+
+# Private key / certificate files
+*.pem
+*.key
+
+# Credential / token files
+*_key.json
+*_credentials.json
+*.token
+*.secret
+
+# Database dumps
+*.sql
+*.sqlite3
+
+# Local configuration overrides (if any)
+*_local.py
+
+# Backup / temporary files that may contain copies of secrets
+*.bak
+*.tmp
